rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function tradesperson() { return signedIn() && exists(/databases/$(database)/documents/tradespeople/$(request.auth.uid)); }
    function matchesTrade(job) {
      let tp = get(/databases/$(database)/documents/tradespeople/$(request.auth.uid)).data;
      return job.city == 'Beograd' && (!('city' in tp) || tp.city == job.city)
        && job.specializationRequired == tp.specialization;
    }
    function assigned(job) {
      return signedIn() && ('acceptedByTradespersonId' in job)
        && job.acceptedByTradespersonId == request.auth.uid
        && job.status in ['accepted', 'completed'];
    }
    match /{document=**} { allow read, write: if false; }
    // Profiles are created atomically by completeRegistration. No browser can
    // create a second role or assign an administrator role, tokens or ratings.
    match /admins/{uid} { allow read: if owner(uid); allow write: if false; }
    match /clients/{uid} { allow read: if owner(uid) || admin(); allow write: if false; }
    match /tradespeople/{uid} {
      allow read: if owner(uid) || admin();
      allow create, delete: if false;
      allow update: if owner(uid) && allowedProfileUpdate(uid);
      match /fcmTokens/{tokenId} { allow read, write: if owner(uid) && tradesperson(); }
    }
    match /jobs/{jobId} {
      allow create, delete: if false;
      allow read: if (signedIn() && resource.data.clientId == request.auth.uid)
        || assigned(resource.data) || admin()
        || (tradesperson() && resource.data.status == 'pending'
          && resource.data.imagesReady == true && matchesTrade(resource.data));
      allow update: if signedIn() && resource.data.clientId == request.auth.uid
        && resource.data.status == 'pending' && !('acceptedByTradespersonId' in resource.data)
        && (!('imageFinalizationSlots' in resource.data) || resource.data.imagesReady == true)
        && request.resource.data.status == 'canceled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'canceledAt'])
        && request.resource.data.canceledAt == request.time;
      match /private/contact {
        allow get: if signedIn() && canReadContact(jobId);
        allow list, write: if false;
      }
    }
    function canReadContact(jobId) {
      let job = get(/databases/$(database)/documents/jobs/$(jobId)).data;
      return job.clientId == request.auth.uid || assigned(job) || admin();
    }
    function allowedProfileUpdate(uid) {
      let neu = request.resource.data;
      let changed = neu.diff(resource.data).affectedKeys();
      return changed.hasOnly(['status', 'dismissedJobs', 'displayName', 'phoneNumber', 'specialization', 'city', 'notificationPreference', 'bio', 'avatarPath', 'avatarUpdatedAt'])
        && neu.status in ['available', 'unavailable']
        && (!('city' in neu) || neu.city == 'Beograd')
        && neu.specialization in ['vodoinstalater', 'električar', 'bravar']
        && neu.displayName is string && neu.displayName.size() >= 2 && neu.displayName.size() <= 80
        && neu.phoneNumber is string && neu.phoneNumber.matches('^\\+[0-9]{8,15}$')
        && (!changed.hasAny(['notificationPreference']) || neu.notificationPreference in ['push', 'viber', 'sms'])
        && (!changed.hasAny(['bio']) || neu.bio == null || (neu.bio is string && neu.bio.size() <= 500))
        && (!changed.hasAny(['avatarPath']) || neu.avatarPath == null || (neu.avatarPath is string && neu.avatarPath.matches('^avatars/' + uid + '/profile\\.jpg$')))
        && (!changed.hasAny(['avatarPath']) || changed.hasAny(['avatarUpdatedAt']))
        && (!changed.hasAny(['avatarUpdatedAt']) || neu.avatarUpdatedAt == request.time)
        && (!('dismissedJobs' in neu) || neu.dismissedJobs == null || (neu.dismissedJobs is list && neu.dismissedJobs.size() <= 200));
    }
  }
}
