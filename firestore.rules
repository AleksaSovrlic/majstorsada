// Firestore Security Rules - MajstorSada (Production-ready)
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() { return request.auth != null; }
    function isAdmin() { return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function isTradespersonUser() { return isAuthenticated() && exists(/databases/$(database)/documents/tradespeople/$(request.auth.uid)); }
    function userSpecialization() { return isTradespersonUser() ? get(/databases/$(database)/documents/tradespeople/$(request.auth.uid)).data.specialization : null; }
    function isSupportedCity(city) { return city == "Beograd"; }
    function userCity() {
      // NOTE: Firestore Rules do NOT support JS-style `if (...) return ...;` statements.
      // Keep it expression-based and safe.
      return isTradespersonUser()
        // Silent fallback for legacy profiles without city: treat as "Beograd".
        ? (("city" in get(/databases/$(database)/documents/tradespeople/$(request.auth.uid)).data)
            && get(/databases/$(database)/documents/tradespeople/$(request.auth.uid)).data.city != null
            ? get(/databases/$(database)/documents/tradespeople/$(request.auth.uid)).data.city
            : "Beograd")
        : null;
    }

    // Default deny
    match /{document=**} { allow read, write: if false; }

    // admins
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow create, update, delete: if isAdmin();
    }

    // clients
    match /clients/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;
    }

    // tradespeople
    match /tradespeople/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && isSupportedCity(request.resource.data.city);
      allow update: if isOwner(uid) && isAllowedTradespersonOwnerUpdate();
      allow delete: if false;

      match /fcmTokens/{tokenId} {
        allow read, create, update, delete: if isOwner(uid);
      }
    }

    // jobs
    match /jobs/{jobId} {
      allow create: if isAuthenticated()
                    && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.status == "pending"
                    && isSupportedCity(request.resource.data.city)
                    && !("acceptedByTradespersonId" in request.resource.data);

      allow read: if isAdmin()
                  || (isAuthenticated() && resource.data.clientId == request.auth.uid)
                  || (isTradespersonUser() && (
                        (resource.data.status == "pending"
                          && resource.data.specializationRequired == userSpecialization()
                          && isSupportedCity(resource.data.city)
                          && resource.data.city == userCity())
                        || (resource.data.acceptedByTradespersonId == request.auth.uid)
                     ));

      allow update: if isClientCancellingOwnPendingJob()
                    || isClientAttachingImagesToOwnPendingJob(jobId);
      allow delete: if false;
    }

    function isClientAttachingImagesToOwnPendingJob(jobId) {
      let old = resource.data;
      let neu = request.resource.data;
      let changed = neu.diff(old).changedKeys();
      // Only allow adding/updating imagePaths + imagesUpdatedAt (no other mutations).
      let onlyAllowed = changed.hasOnly(["imagePaths", "imagesUpdatedAt", "imagesReady"]);
      let ownerOk = isAuthenticated() && old.clientId == request.auth.uid;
      let statusOk = old.status == "pending" && neu.status == old.status;
      let notAccepted = !("acceptedByTradespersonId" in old);

      let pathsOk =
        ("imagePaths" in neu)
        && (neu.imagePaths is list)
        && (neu.imagePaths.size() <= 3)
        // Validate each element (no loops in rules, so do it by index).
        && (neu.imagePaths.size() == 0
            || (neu.imagePaths[0] is string && neu.imagePaths[0].matches("^jobs/" + jobId + "/[^/]+$")))
        && (neu.imagePaths.size() <= 1
            || (neu.imagePaths[1] is string && neu.imagePaths[1].matches("^jobs/" + jobId + "/[^/]+$")))
        && (neu.imagePaths.size() <= 2
            || (neu.imagePaths[2] is string && neu.imagePaths[2].matches("^jobs/" + jobId + "/[^/]+$")));

      // Require serverTimestamp to prevent client forging arbitrary times.
      let updatedAtOk = ("imagesUpdatedAt" in neu) && neu.imagesUpdatedAt == request.time;
      let readyOk =
        ("imagesReady" in neu)
        && (neu.imagesReady is bool)
        // Disallow true -> false (monotonic)
        && (!("imagesReady" in old) || old.imagesReady != true || neu.imagesReady == true);

      return onlyAllowed && ownerOk && statusOk && notAccepted && pathsOk && updatedAtOk && readyOk;
    }

    function isClientCancellingOwnPendingJob() {
      let old = resource.data;
      let neu = request.resource.data;
      let changed = neu.diff(old).changedKeys();
      // Allow ONLY a strict state transition: pending -> canceled, by the owner client,
      // and require canceledAt == request.time (serverTimestamp).
      return isAuthenticated()
        && old.clientId == request.auth.uid
        && old.status == "pending"
        && neu.status == "canceled"
        && !("acceptedByTradespersonId" in old)
        && changed.hasOnly(["status", "canceledAt"])
        && ("canceledAt" in neu)
        && neu.canceledAt == request.time;
    }

    function isAllowedTradespersonOwnerUpdate() {
      let old = resource.data;
      let neu = request.resource.data;
      // Dodat 'notificationPreference' u allowedKeys
      let allowedKeys = ["status", "dismissedJobs", "displayName", "phoneNumber", "specialization", "city", "notificationPreference"];
      let forbiddenKeys = ["balanceTokens", "ratingSum", "ratingCount", "averageRating"];
      let changed = neu.diff(old).changedKeys();
      let noForbiddenChanged = !changed.hasAny(forbiddenKeys);
      let onlyAllowed = changed.hasOnly(allowedKeys);
      // Eksplicitna validacija status vrednosti (bez 'in' nad listom)
      let statusOk = !("status" in neu) || (neu.status == "available" || neu.status == "unavailable");
      let cityOk = !("city" in neu) || isSupportedCity(neu.city);
      // Bez lambda/iteracija: tip liste + gornja granica veličine; dozvoli null
      let dismissedOk = !("dismissedJobs" in neu) || (neu.dismissedJobs == null) || (neu.dismissedJobs is list && neu.dismissedJobs.size() <= 200);
      return noForbiddenChanged && onlyAllowed && statusOk && cityOk && dismissedOk;
    }
  }
}


