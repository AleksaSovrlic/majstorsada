{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build && node tools/prepare-ssr.mjs",
    "dev": "nuxt dev --port 3333",
    "deploy:prod": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/deploy-prod.ps1",
    "emulators:start": "node tools/start-emulators.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:security": "npm --prefix functions run build && node tests/security/run.mjs",
    "ssr:refresh": "nuxt build && node tools/prepare-ssr.mjs --refresh",
    "test:build": "node --test tests/build/ssr-deps.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:ssr": "node tests/build/run.mjs"
  },
  "dependencies": {
    "@nuxtjs/robots": "6.2.2",
    "@nuxtjs/sitemap": "8.5.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "0.11.3",
    "@vue/devtools-api": "8.2.1",
    "firebase": "12.19.0",
    "firebase-functions": "7.3.2",
    "geofire-common": "^6.0.0",
    "libphonenumber-js": "^1.12.23",
    "nuxt": "4.5.2",
    "nuxt-schema-org": "6.3.1",
    "pinia": "3.0.4",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "cac": "6.7.14",
    "commander": "14.0.3",
    "firebase-admin": "14.4.0",
    "firebase-tools": "15.30.0",
    "unplugin": "3.3.0"
  },
  "volta": {
    "node": "24.18.0"
  }
}
