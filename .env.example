# Public client-side configuration values used by Nuxt/Firebase.
# These are not private service account credentials, but use project-specific values.
NUXT_PUBLIC_SITE_URL=http://localhost:3333
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NUXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=europe-west3
NUXT_PUBLIC_FIREBASE_MESSAGING_VAPID_KEY=
NUXT_PUBLIC_MAPBOX_TOKEN=

# Local emulator seed script only. Do not use production credentials here.
SEED_TRADESPERSON_EMAIL=
SEED_TRADESPERSON_PASSWORD=

# Never commit .env or .env.production.
# Never commit Firebase service account keys.
# functions/.keys/serviceAccountKey.json must remain local only.
