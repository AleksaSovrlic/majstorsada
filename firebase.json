{
  "functions": [
    {
      "source": "functions",
      "codebase": "api",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        ".nuxt",
        ".keys",
        "**/test/**"
      ]
    },
    {
      "source": ".output/server",
      "codebase": "nuxt-ssr",
      "predeploy": [
        "node \"$PROJECT_DIR/tools/assert-ssr-deps.mjs\""
      ],
      "ignore": [
        "node_modules",
        ".git"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".output/public",
    "//": "Prerendered routes are written as <route>/index.html (Nitro's autoSubfolderIndex). Without this, Hosting 301s /vodoinstalater to /vodoinstalater/, changing URLs that are already indexed. Verified on a preview channel.",
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "comment": "Prerendered pages. Firebase defaults static content to max-age=3600, which would let a returning visitor see the previous deploy for up to an hour. The referenced _nuxt assets are content-hashed, so revalidating the HTML is enough.",
        "source": "/@(|vodoinstalater|elektricar|bravar)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/firebase-messaging-sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/majstor/**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/klijent/**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/login",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/finishLogin",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/zahtev",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      },
      {
        "source": "/potvrda",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "function": {
          "functionId": "server",
          "region": "europe-west3",
          "codebase": "nuxt-ssr"
        }
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9199
    },
    "functions": {
      "port": 5501
    },
    "firestore": {
      "port": 8180
    },
    "storage": {
      "port": 9399
    },
    "hosting": {
      "port": 5500
    },
    "ui": {
      "enabled": true,
      "port": 4401
    }
  }
}



