rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function job(jobId) { return firestore.get(/databases/(default)/documents/jobs/$(jobId)).data; }
    // Only the authenticated readJobImage server can read published bytes.
    // A browser cannot obtain a persistent Firebase download URL for these files.
    match /jobs/{jobId}/{file} { allow read, write: if false; }
    function canStage(uid, jobId, file) {
      let j = job(jobId);
      return signedIn() && request.auth.uid == uid && j.clientId == uid && j.schemaVersion == 2
        && j.status == 'pending' && j.imagesReady == false && !('imageFinalizationSlots' in j)
        && ((file == '0.jpg' && j.photoCount >= 1) || (file == '1.jpg' && j.photoCount >= 2) || (file == '2.jpg' && j.photoCount >= 3));
    }
    match /job-uploads/{uid}/{jobId}/{file} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if resource == null && canStage(uid, jobId, file) && request.resource.size > 0 && request.resource.size < 3 * 1024 * 1024 && request.resource.contentType == 'image/jpeg';
      allow delete: if canStage(uid, jobId, file);
      allow list, update: if false;
    }
    // Public profile avatars retain their existing behavior.
    match /avatars/{uid}/{file} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && file == 'profile.jpg'
        && request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
