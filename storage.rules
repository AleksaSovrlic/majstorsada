rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() { return request.auth != null; }
    
    function jobDoc(jobId) {
      return firestore.get(/databases/(default)/documents/jobs/$(jobId)).data;
    }

    // Zadrzavamo strogu logiku SAMO za WRITE (upload)
    function canWriteJobImage(jobId, file) {
      let j = jobDoc(jobId);
      let expectedPath = "jobs/" + jobId + "/" + file;
      return isAuthenticated()
        && j.clientId == request.auth.uid
        && j.status == "pending"
        && !("acceptedByTradespersonId" in j)
        && ("imagePaths" in j)
        && (j.imagePaths is list)
        && (j.imagePaths.size() <= 3)
        && j.imagePaths.hasAny([expectedPath])
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // --- GLAVNA PROMENA OVDE ---
    match /jobs/{jobId}/{file} {
      // READ: Dozvoljavamo svakom ulogovanom korisniku (bez skupih Firestore provera)
      allow read: if request.auth != null;
      
      // WRITE: Ostaje strogo (samo vlasnik uz validaciju)
      allow write: if canWriteJobImage(jobId, file);
    }

    // Avatari ostaju isti
    match /avatars/{uid}/{file} {
      allow read: if true;
      allow write: if isAuthenticated()
        && request.auth.uid == uid
        && file == "profile.jpg"
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}